{
  "name": "miki-website",
  "version": "6.3.5",
  "private": true,
  "type": "module",
  "scripts": {
    "core:check": "node scripts/check-structmark-core.mjs",
    "core:sync": "node scripts/sync-structmark-core.mjs",
    "dev": "next dev",
    "build": "next build && node scripts/fix-static-lang.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "docs:check": "npm run notes:check && node scripts/check-sm.mjs",
    "validate": "npm run validate:fast && npm run test:e2e",
    "preview": "python3 -m http.server 4173 --directory out",
    "notes:sync": "node scripts/sync-notes.mjs",
    "notes:check": "node scripts/sync-notes.mjs --check",
    "test:native": "node --experimental-strip-types --test tests/native/*.test.mjs",
    "validate:fast": "npm run audit:repo && npm run test:native && npm run core:check && npm run works:check && npm run docs:check && npm test && npm run typecheck && npm run build",
    "works:check": "node --experimental-strip-types scripts/check-projects.mjs",
    "audit:repo": "node scripts/audit-repository.mjs"
  },
  "dependencies": {
    "katex": "^0.16.47",
    "next": "^16.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.6"
  }
}
