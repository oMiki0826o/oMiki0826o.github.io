---
import type {Locale} from '@/i18n/config';
import {ui} from '@/i18n/ui';
import {SiteHeader} from '@/components/layout/site-header';
import {Fireflies} from '@/components/ui/fireflies';
import {SiteJsonLd} from '@/components/seo/json-ld';
import {siteUrl} from '@/lib/metadata';
import '@/app/styles/site.css';
import '@/app/styles/page-extras.css';
import '@/app/styles/structmark.css';
import 'katex/dist/katex.min.css';

type Props = {locale?: Locale; title?: string; description?: string; shell?: boolean};
const {locale = 'zh-TW', title = "Miki's Website", description = 'Miki 的個人網站：作品、文章與日常紀錄。', shell = true} = Astro.props;
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Miki's Website" />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/miki-avatar.jpeg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Klee+One:wght@600&family=Noto+Sans+TC:wght@400;500;600&family=Nunito:wght@500;600;700;800&family=Zen+Maru+Gothic:wght@500;700&display=swap" />
    <script is:inline>try {var t=localStorage.getItem('miki-theme');document.documentElement.dataset.theme=t==='dark'?'dark':'light'}catch(e){}</script>
  </head>
  <body>
    <SiteJsonLd />
    {shell ? <>
      <Fireflies client:load />
      <div class="page" lang={locale}>
        <SiteHeader client:load locale={locale} pathname={Astro.url.pathname} />
        <slot />
      </div>
    </> : <slot />}
  </body>
</html>
